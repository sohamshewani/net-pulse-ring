<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.network</groupId>
    <artifactId>net-pulse-ring</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>net-pulse-ring</name>
    <description>High-performance network pulse ring buffer with native optimizations.</description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.10.0</junit.version>
        <jmh.version>1.37</jmh.version>
    </properties>

    <dependencies>
        <!-- JMH for benchmarking -->
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-core</artifactId>
            <version>${jmh.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-generator-annprocess</artifactId>
            <version>${jmh.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- JUnit 5 for testing -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Compiler Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>${maven.compiler.source}</source>
                    <target>${maven.compiler.target}</target>
                    <compilerArgs>
                        <arg>-Xlint:all</arg>
                        <arg>-Werror</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <!-- Surefire Plugin for Unit Tests -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.1.2</version>
            </plugin>

            <!-- Exec Maven Plugin to safely handle custom make/script targets -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <!-- Target: native-compile (applies -O3, -Wall, -Wextra if src/main/c exists) -->
                    <execution>
                        <id>compile-native-code</id>
                        <phase>process-sources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>sh</executable>
                            <workingDirectory>${project.basedir}</workingDirectory>
                            <commandlineArgs>-c '
                                if [ -d "src/main/c" ] || [ -d "src/main/cpp" ]; then
                                    echo "Compiling native sources with -O3 -Wall -Wextra..."
                                    mkdir -p target/native
                                    # Example gcc command adapting optimization flags securely
                                    for file in src/main/c/*.c src/main/cpp/*.cpp; do
                                        [ -e "$file" ] || continue
                                        gcc -O3 -Wall -Wextra -c "$file" -o "target/native/$(basename ${file%.*}).o"
                                    done
                                else
                                    echo "No optional native (C/C++) source folder found. Skipping native compilation."
                                fi
                            '</commandlineArgs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>

        <pluginManagement>
            <plugins>
                <!-- AntRun plugin to fulfill workflow targets (all, build, test, clean, benchmark) -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-antrun-plugin</artifactId>
                    <version>3.1.0</version>
                    <executions>
                        <!-- Target: clean (Extends default clean to clear optional artifacts safely) -->
                        <execution>
                            <id>custom-clean</id>
                            <phase>clean</phase>
                            <goals>
                                <goal>run</goal>
                            </goals>
                            <configuration>
                                <target>
                                    <echo message="Executing custom clean..." />
                                    <delete dir="target" quiet="true" />
                                    <delete dir="benchmarks-output" quiet="true" />
                                </target>
                            </configuration>
                        </execution>

                        <!-- Target: build -->
                        <execution>
                            <id>target-build</id>
                            <phase>compile</phase>
                            <goals>
                                <goal>run</goal>
                            </goals>
                            <configuration>
                                <target>
                                    <echo message="Target [build] executed successfully via Maven compile phase." />
                                </target>
                            </configuration>
                        </execution>

                        <!-- Target: all -->
                        <execution>
                            <id>target-all</id>
                            <phase>package</phase>
                            <goals>
                                <goal>run</goal>
                            </goals>
                            <configuration>
                                <target>
                                    <echo message="Target [all] completed: project compiled and packaged." />
                                </target>
                            </configuration>
                        </execution>

                        <!-- Target: benchmark -->
                        <execution>
                            <id>target-benchmark</